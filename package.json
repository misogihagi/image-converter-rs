{
  "name": "image-converter-rs-root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "build:wasm:node": "wasm-pack build crates/wasm --target nodejs --out-dir ../../packages/image-converter-wasm/dist/node",
    "build:wasm:web": "wasm-pack build crates/wasm --target web --out-dir ../../packages/image-converter-wasm/dist/web",
    "test:node": "node examples/node/convert.mjs",
    "test": "npm run build && npm run test:node"
  },
  "devDependencies": {
    "wasm-pack": "^0.15.0"
  }
}
